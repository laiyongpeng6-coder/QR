{
  "enabled": true,
  "name": "中文语言偏好",
  "description": "确保所有对话回复、文档、注释和说明都使用简体中文。代码本身（变量名、函数名等）和命令行指令可以保持英文。",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "请使用简体中文进行所有回复和对话。撰写的文档、注释和说明都使用中文。代码注释使用中文。错误信息和提示使用中文。例外情况：代码本身（变量名、函数名等）可以使用英文，命令行指令保持原样。"
  }
}