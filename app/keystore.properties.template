# ============================================================================
# 签名配置模板
# ============================================================================
# 给其他 AI 开发者的说明：
# 1. 复制此文件为 keystore.properties（不要提交到 Git）
# 2. 填入实际的 keystore 路径和密码
# 3. 在 app/build.gradle.kts 中读取此文件配置 signingConfigs
#
# 生成 keystore 命令：
# keytool -genkey -v -keystore qrscanmax-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias qrscanmax
# ============================================================================

storeFile=../qrscanmax-release.jks
storePassword=your_store_password
keyAlias=qrscanmax
keyPassword=your_key_password
